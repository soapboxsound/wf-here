# Server-side (Vercel API routes)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Admin access — use the same Google account you sign in with on the site
ADMIN_EMAIL=you@gmail.com
# Or multiple admins:
# ADMIN_EMAILS=you@gmail.com,partner@gmail.com

# Optional emergency fallback (prefer Google login above)
# ADMIN_PASSWORD=choose-a-long-random-password

# Firebase Admin SDK (required for /api/admin/*)
# Paste the full service account JSON as a single line string:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"wf-here",...}

# Client-side (generated into js/config.js at build time)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_MAPBOX_TOKEN=your_mapbox_public_token

# Optional — used when generating sitemap + prerendered place pages
SITE_URL=https://wf-here.com
